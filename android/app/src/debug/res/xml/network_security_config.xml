<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped cleartext exception for local development only — never
  `cleartextTrafficPermitted="true"` at the base-config level.

  10.0.2.2 is how the Android emulator reaches the host machine; the API
  there runs over plain http in dev (see AppConfig.forEnvironment and
  docs/flutter_production_migration.md, step 3). This file is only packaged
  into debug/profile builds — release keeps the platform default (cleartext
  blocked everywhere) because production always talks https.

  127.0.0.1 covers a physical device on "adb reverse tcp:5116 tcp:5116",
  which forwards the device's own loopback to the host's — the device never
  sees 10.0.2.2 in that setup, only its own localhost. Used with the
  AK_API_BASE_URL dart define, set to http://127.0.0.1:5116/api/v1.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
